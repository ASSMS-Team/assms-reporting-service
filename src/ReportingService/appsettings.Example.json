{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "default": "Server=localhost;Port=3306;Database=reportingdb;User ID=<your-mysql-user>;Password=<your-mysql-password>;"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Authentication": {
    "Jwt": {
      "//": "Must match Authentication:Jwt in Customer & Asset Service, which issues the staff JWT.",
      "Issuer": "assms-customer-asset-service",
      "Audience": "assms-internal",
      "SigningKey": "<shared-jwt-signing-key-at-least-32-bytes>"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
